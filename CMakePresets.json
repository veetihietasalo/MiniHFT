{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MINIHFT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-debug-stl",
      "displayName": "GCC Debug + libstdc++ debug mode",
      "description": "Checked iterators and containers: invalidated iterators, operator[] out of range but within capacity. In CMAKE_CXX_FLAGS so every target, GoogleTest included, gets the debug containers' layout.",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_DEBUG -D_GLIBCXX_DEBUG_PEDANTIC -D_GLIBCXX_ASSERTIONS",
        "MINIHFT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Clang + ThreadSanitizer",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "MINIHFT_SANITIZER": "thread",
        "MINIHFT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "asan-ubsan",
      "hidden": true,
      "description": "ASan, UBSan, and the UBSan checks -fsanitize=undefined leaves out (CMakeLists.txt says why unsigned-integer-overflow isn't one of them)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "MINIHFT_SANITIZER": "address,undefined,float-divide-by-zero,local-bounds,implicit-conversion,nullability"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "displayName": "Clang + AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": ["linux-base", "asan-ubsan"],
      "cacheVariables": {
        "MINIHFT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "clang-fuzz",
      "displayName": "Clang + libFuzzer (with ASan and UBSan)",
      "inherits": ["linux-base", "asan-ubsan"],
      "cacheVariables": {
        "MINIHFT_BUILD_FUZZERS": "ON",
        "MINIHFT_BUILD_TESTS": "OFF",
        "MINIHFT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Compile database for clang-tidy (configure only)",
      "description": "Every target, the fuzzer included, and no sanitizer, so clang-tidy sees every source file",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "MINIHFT_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "gcc-debug-stl", "configurePreset": "gcc-debug-stl" },
    { "name": "clang-tsan", "configurePreset": "clang-tsan" },
    { "name": "clang-asan-ubsan", "configurePreset": "clang-asan-ubsan" },
    { "name": "clang-fuzz", "configurePreset": "clang-fuzz", "targets": ["itch_fuzz", "gen_itch"] }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "msvc-release", "inherits": "test-base", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "gcc-release", "inherits": "test-base", "configurePreset": "gcc-release" },
    { "name": "gcc-debug-stl", "inherits": "test-base", "configurePreset": "gcc-debug-stl" },
    {
      "name": "clang-tsan",
      "inherits": "test-base",
      "configurePreset": "clang-tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1" }
    },
    {
      "name": "clang-asan-ubsan",
      "inherits": "test-base",
      "configurePreset": "clang-asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ]
}
